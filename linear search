#include <stdio.h>

int main() {
    int arr[] = {10, 25, 30, 45, 50};
    int n = 5;
    int key = 30;
    int found = -1;

    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            found = i;
            break;
        }
    }

    if (found != -1)
        printf("Element found at index %d\n", found);
    else
        printf("Element not found\n");

    return 0;
}
